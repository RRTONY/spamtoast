# Copy to .env.local and fill in. Also set every one of these in Netlify's
# dashboard (Site configuration > Environment variables).

# Public address of the site.
NEXT_PUBLIC_SITE_URL=

# Resend (reports and "they opened your link" emails to Tony).
RESEND_API_KEY=
# Optional sender override, e.g. "SpamToast <toast@spamtoast.com>" once
# spamtoast.com is verified in Resend.
EMAIL_FROM=
# Where report and open alerts go (default tony@tonygreenberg.com).
OWNER_EMAIL=

# Signs the personal /youve-been-reported links. Any long random string
# (openssl rand -base64 32). Changing it breaks every link already sent.
CONFRONT_LINK_SECRET=

# --- MCP server (/api/mcp): lets Claude Code / Claude Desktop / Claude.ai / ChatGPT edit this
# site's code as a pull request on an admin/mcp-* branch. See docs/ai/mcp-server.md.
# Optional. "owner/name" of the repo the server edits. Default RRTONY/spamtoast.
GITHUB_REPO=
# Fine-grained GitHub token scoped to RRTONY/spamtoast only: Contents + Pull requests =
# Read and write, Actions + Commit statuses = Read. Mind its expiry date. It also writes the
# change records to the repo's mcp-change-log branch (the site has no database).
GITHUB_TOKEN=
# JSON array, one entry per person, role read | edit | write. Email lets them sign in on
# /oauth/authorize; token is optional (64 hex, `openssl rand -hex 32`) for Claude Code's fixed header:
# [{"name":"Jane Doe","email":"jane@example.com","role":"write","token":"<optional>"}]
MCP_ADMIN_USERS=
# Shared team password for the /oauth/authorize sign-in page. Changing it signs everyone out.
MCP_LOGIN_PASSWORD=
# Signs sign-in codes and access tokens, from `openssl rand -hex 32`. Never reuse another secret.
MCP_OAUTH_SECRET=
# Optional. Public origin the OAuth metadata advertises (e.g. https://spamtoast.com).
MCP_PUBLIC_ORIGIN=
# Optional. Extra comma-separated hosts allowed as sign-in callbacks (claude.ai, claude.com,
# chatgpt.com, chat.openai.com and localhost are always allowed).
MCP_OAUTH_REDIRECT_HOSTS=
# Optional. Origin seo_check_page fetches. Until the domain points at Netlify, set it to the
# Netlify site URL. Falls back to NEXT_PUBLIC_SITE_URL.
MCP_SITE_ORIGIN=
# Optional. Google API key with PageSpeed Insights enabled, for lighthouse_check_page.
GOOGLE_API_KEY=

# --- Netlify (MCP check_deploy, read-only; preview links) ---
# Netlify project name: previews are deploy-preview-N--<name>.netlify.app. Default spamtoast.
NETLIFY_SITE_NAME=
# Netlify site ID (Netlify sets SITE_ID itself on the deployed site, so this is mainly for local).
NETLIFY_SITE_ID=
# Personal access token; check_deploy only ever reads this site's deploys.
NETLIFY_AUTH_TOKEN=
